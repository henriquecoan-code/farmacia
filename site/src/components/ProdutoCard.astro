---
// Card de produto. A busca (src/scripts/card-html.ts) gera o mesmo HTML no navegador:
// ao mudar a estrutura aqui, mude lá também. Estilos em styles/produto-card.css.
import type { Produto } from '../lib/catalogo';
import { brl, temDesconto, percentualDesconto } from '../lib/catalogo';
import { urlProduto } from '../lib/url';
import ProdutoImagem from './ProdutoImagem.astro';

interface Props { produto: Produto; eager?: boolean }
const { produto: p, eager = false } = Astro.props;
const desconto = temDesconto(p);
---
<article class="card">
  <a class="card__link" href={urlProduto(p.slug)}>
    <ProdutoImagem produto={p} eager={eager} />
    <div class="card__selos">
    </div>
    <h3 class="card__nome">{p.nome}</h3>
    {p.laboratorio && <p class="card__lab">{p.laboratorio}</p>}
  </a>
  <div class="card__preco">
    {desconto && <span class="card__de"><s>{brl(p.preco_maximo)}</s><span class="selo selo--desconto">-{percentualDesconto(p)}%</span></span>}
    <strong>{brl(p.preco)}</strong>
  </div>
  <div class="card__comprar">
    <div class="qtd-mini">
      <button type="button" data-qtd-passo="-1" aria-label="Diminuir quantidade">−</button>
      <input type="number" inputmode="numeric" min="1" max={p.estoque} value="1" aria-label={`Quantidade de ${p.nome}`} />
      <button type="button" data-qtd-passo="1" aria-label="Aumentar quantidade">+</button>
    </div>
    <button type="button" class="btn btn--primario card__add" data-add-carrinho
            data-produto={JSON.stringify({ cod_red: p.cod_red, slug: p.slug, nome: p.nome, preco: p.preco, estoque: p.estoque, tipo_venda: p.tipo_venda })}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6"/><path d="M14 2v6M11 5h6"/></svg>
      <span class="card__add-txt">Adicionar</span>
    </button>
  </div>
</article>
