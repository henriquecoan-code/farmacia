---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Catalogo from '../../components/Catalogo.astro';
import Listagem from '../../components/Listagem.astro';
import { carregarProdutos, temDesconto, percentualDesconto, type Produto } from '../../lib/catalogo';
import { u } from '../../lib/url';

export const getStaticPaths = (async () => {
  const POR_PAGINA = 48;
  const itens = (await carregarProdutos()).filter(temDesconto).sort((a, b) => percentualDesconto(b) - percentualDesconto(a));
  const total = Math.max(1, Math.ceil(itens.length / POR_PAGINA));
  return Array.from({ length: total }, (_, i) => ({
    params: { pagina: i === 0 ? undefined : String(i + 1) },
    props: { pagina: i + 1, totalPaginas: total, totalItens: itens.length, itens: itens.slice(i * POR_PAGINA, (i + 1) * POR_PAGINA) },
  }));
}) satisfies GetStaticPaths;

interface Props { pagina: number; totalPaginas: number; totalItens: number; itens: Produto[] }
const { pagina, totalPaginas, totalItens, itens } = Astro.props;
---
<Base title={pagina > 1 ? `Ofertas — página ${pagina}` : 'Ofertas'} description={`${totalItens} produtos com desconto na Farmácia São Benedito.`}>
  <Catalogo ofertas>
    <Listagem titulo="Ofertas" descricao="Produtos com desconto, do maior para o menor." migalhas={[{ nome: 'Ofertas' }]}
      itens={itens} pagina={pagina} totalPaginas={totalPaginas} totalItens={totalItens}
      urlPagina={(n) => u(n > 1 ? `/ofertas/${n}/` : '/ofertas/')} />
  </Catalogo>
</Base>
