---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ProdutoImagem from '../../components/ProdutoImagem.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import { carregarProdutos, brl, temDesconto, percentualDesconto, secaoDaCategoria, NOME_CATEGORIA, type Produto } from '../../lib/catalogo';
import { loja, linkWhatsApp } from '../../data/loja';
import { u, urlProduto, urlSecao } from '../../lib/url';

export const getStaticPaths = (async () => {
  const produtos = await carregarProdutos();
  // "Mesmo princípio ativo": ajuda a comparar referência, genérico e similar
  const porDcb = new Map<string, Produto[]>();
  for (const p of produtos) {
    if (!p.dcb) continue;
    const k = p.dcb.trim().toUpperCase();
    porDcb.set(k, [...(porDcb.get(k) ?? []), p]);
  }
  return produtos.map((p) => ({
    params: { slug: p.slug },
    props: {
      produto: p,
      equivalentes: p.dcb ? (porDcb.get(p.dcb.trim().toUpperCase()) ?? []).filter((x) => x.cod_red !== p.cod_red).sort((a, b) => a.preco - b.preco).slice(0, 8) : [],
    },
  }));
}) satisfies GetStaticPaths;

interface Props { produto: Produto; equivalentes: Produto[] }
const { produto: p, equivalentes } = Astro.props;
const secao = secaoDaCategoria(p.categoria);
const presc = p.tipo_venda === 'prescricao';
const medicamento = secao.slug === 'medicamentos';
const desconto = temDesconto(p) && !presc; // RDC 96/2008
const url = new URL(urlProduto(p.slug), Astro.site).href;

const descricao = `${p.nome}${p.laboratorio ? ` — ${p.laboratorio}` : ''}${p.dcb ? `. Princípio ativo: ${p.dcb.toLowerCase()}` : ''}. ${brl(p.preco)} na Farmácia São Benedito, com entrega em Lauro Müller e região.`;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.nome,
    sku: String(p.cod_red),
    ...(p.ean ? { gtin13: p.ean } : {}),
    ...(p.laboratorio ? { brand: { '@type': 'Brand', name: p.laboratorio } } : {}),
    ...(p.fotos[0] ? { image: p.fotos[0] } : {}),
    description: p.descricao || descricao,
    category: NOME_CATEGORIA[p.categoria] ?? secao.nome,
    offers: {
      '@type': 'Offer',
      url,
      priceCurrency: 'BRL',
      price: p.preco.toFixed(2),
      availability: p.estoque > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      seller: { '@type': 'Pharmacy', name: loja.nomeFantasia },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: new URL(u('/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: secao.nome, item: new URL(urlSecao(secao.slug), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: p.nome, item: url },
    ],
  },
];
const dadosCarrinho = JSON.stringify({ cod_red: p.cod_red, slug: p.slug, nome: p.nome, preco: p.preco, estoque: p.estoque, tipo_venda: p.tipo_venda });
---
<Base title={p.nome} description={descricao} jsonld={jsonld}>
  <nav class="migalhas" aria-label="Você está em">
    <ol><li><a href={u('/')}>Início</a></li><li><a href={urlSecao(secao.slug)}>{secao.nome}</a></li><li aria-current="page">{p.nome}</li></ol>
  </nav>

  <article class="produto" data-pagefind-body data-cod-red={p.cod_red}>
    <div class="produto__img">
      <ProdutoImagem produto={p} grande eager />
    </div>

    <div class="produto__info">
      <p class="produto__cat" data-pagefind-filter="secao">{NOME_CATEGORIA[p.categoria] ?? secao.nome}</p>
      <h1>{p.nome}</h1>
      <span hidden data-pagefind-meta="title">{`${p.nome}${p.laboratorio ? ` — ${p.laboratorio}` : ''} · ${brl(p.preco)}`}</span>
      <dl class="ficha">
        {p.laboratorio && <><dt>Laboratório / marca</dt><dd>{p.laboratorio}</dd></>}
        {p.dcb && <><dt>Princípio ativo</dt><dd>{p.dcb}</dd></>}
        <dt>Código</dt><dd>{p.cod_red}</dd>
        {p.ean && <><dt>EAN</dt><dd>{p.ean}</dd></>}
      </dl>

      <div class="compra">
        <div class="preco" data-ao-vivo-preco>
          {desconto && <s data-ao-vivo="preco_maximo">{brl(p.preco_maximo)}</s>}
          <strong data-ao-vivo="preco" data-pagefind-meta="preco">{brl(p.preco)}</strong>
          {desconto && <span class="selo selo--desconto">-{percentualDesconto(p)}%</span>}
        </div>
        <p class="estoque" data-ao-vivo="estoque">{p.estoque > 0 ? 'Em estoque' : 'Indisponível no momento'}</p>

        <div class="compra__acoes">
          <label class="qtd">
            <span class="sr-only">Quantidade</span>
            <input id="qtd" type="number" inputmode="numeric" min="1" max={p.estoque} value="1" />
          </label>
          <button type="button" class="btn btn--primario" data-add-carrinho data-qtd-input="qtd" data-produto={dadosCarrinho}>
            Adicionar ao carrinho
          </button>
        </div>

        {presc ? (
          <p class="aviso aviso--receita"><strong>Venda sob prescrição médica.</strong> Apresente a receita na entrega ou na retirada.
            Sem receita válida, o medicamento não é entregue.</p>
        ) : medicamento ? (
          <p class="aviso aviso--mip">{p.nome.split(' ')[0].toUpperCase()} É UM MEDICAMENTO. SEU USO PODE TRAZER RISCOS. PROCURE O MÉDICO E O FARMACÊUTICO. LEIA A BULA.</p>
        ) : null}
        <a class="btn btn--whats btn--bloco" href={linkWhatsApp(`Olá! Tenho uma dúvida sobre o produto ${p.nome} (cód. ${p.cod_red}).`)} target="_blank" rel="noopener">
          Tirar dúvida com o farmacêutico
        </a>
      </div>

      {p.descricao && <section class="descricao"><h2>Descrição</h2><p>{p.descricao}</p></section>}
    </div>
  </article>

  {equivalentes.length > 0 && (
    <section class="secao" aria-labelledby="t-eq">
      <h2 id="t-eq">Mesmo princípio ativo</h2>
      <p class="eq__dica">Opções com o mesmo princípio ativo, do menor para o maior preço. Confirme a troca com o farmacêutico ou o médico.</p>
      <div class="grade">{equivalentes.map((e) => <ProdutoCard produto={e} />)}</div>
    </section>
  )}

  <script>
    import { atualizarAoVivo } from '../../scripts/ao-vivo';
    atualizarAoVivo();
  </script>
</Base>

<style>
  .produto { display: grid; gap: 20px; padding: 8px 0 16px; }
  @media (min-width: 860px) { .produto { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 40px; } }
  .produto__img { background: #fff; border: 1px solid var(--borda); border-radius: 16px; padding: 12px; align-self: start; }
  @media (max-width: 859px) { .produto__img { max-width: 420px; width: 100%; margin: 0 auto; } }
  .produto__cat { margin: 0 0 4px; color: var(--azul); font-weight: 700; font-size: .85rem; text-transform: uppercase; letter-spacing: .04em; }
  .ficha { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; margin: 0 0 16px; font-size: .92rem; }
  .ficha dt { color: var(--texto-3); }
  .ficha dd { margin: 0; overflow-wrap: anywhere; }
  .compra { background: #fff; border: 1px solid var(--borda); border-radius: 16px; padding: 16px; display: grid; gap: 12px; box-shadow: var(--sombra); }
  .preco { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .preco s { color: var(--texto-3); }
  .preco strong { font-size: 2rem; line-height: 1; }
  .estoque { margin: 0; color: var(--verde); font-weight: 600; }
  .estoque.esgotado { color: var(--vermelho); }
  .compra__acoes { display: grid; grid-template-columns: 88px 1fr; gap: 8px; }
  .qtd input { width: 100%; height: 44px; border: 1px solid #cbd5e1; border-radius: 10px; text-align: center; font: inherit; font-size: 16px; }
  .aviso { margin: 0; }
  .aviso--mip { font-size: .78rem; letter-spacing: .01em; }
  .descricao { margin-top: 20px; }
  .eq__dica { color: var(--texto-2); font-size: .9rem; margin-top: -4px; }
</style>
