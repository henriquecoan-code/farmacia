---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Catalogo from '../../../components/Catalogo.astro';
import Listagem from '../../../components/Listagem.astro';
import { carregarProdutos, SECOES, type Secao, type Produto } from '../../../lib/catalogo';
import { NOME_TIPO } from '../../../lib/secoes';
import { u, urlSecao } from '../../../lib/url';

export const getStaticPaths = (async () => {
  const POR_PAGINA = 48; // getStaticPaths é isolado do resto do arquivo: a constante fica aqui dentro
  const produtos = await carregarProdutos();
  return SECOES.flatMap((secao) => {
    const itens = produtos.filter((p) => secao.categorias.includes(p.categoria));
    const total = Math.max(1, Math.ceil(itens.length / POR_PAGINA));
    const tipos = secao.categorias.length > 1 ? secao.categorias.filter((c) => itens.some((p) => p.categoria === c)) : [];
    return Array.from({ length: total }, (_, i) => ({
      params: { secao: secao.slug, pagina: i === 0 ? undefined : String(i + 1) },
      props: { secao, tipos, pagina: i + 1, totalPaginas: total, totalItens: itens.length, itens: itens.slice(i * POR_PAGINA, (i + 1) * POR_PAGINA) },
    }));
  });
}) satisfies GetStaticPaths;

interface Props { secao: Secao; tipos: string[]; pagina: number; totalPaginas: number; totalItens: number; itens: Produto[] }
const { secao, tipos, pagina, totalPaginas, totalItens, itens } = Astro.props;
const titulo = pagina > 1 ? `${secao.nome} — página ${pagina}` : secao.nome;
const atalhos = tipos.length
  ? [{ nome: 'Todos', href: urlSecao(secao.slug), ativo: true }, ...tipos.map((c) => ({ nome: NOME_TIPO[c] ?? c, href: u(`/tipo/${c}/`) }))]
  : [];
---
<Base title={titulo} description={`${secao.nome} na Farmácia São Benedito: ${secao.descricao} ${totalItens} produtos com entrega em Lauro Müller e região.`}>
  <Catalogo secao={secao.slug}>
    <Listagem titulo={secao.nome} descricao={secao.descricao} migalhas={[{ nome: secao.nome }]}
      itens={itens} pagina={pagina} totalPaginas={totalPaginas} totalItens={totalItens}
      urlPagina={(n) => urlSecao(secao.slug, n)} atalhos={atalhos} />
  </Catalogo>
</Base>
